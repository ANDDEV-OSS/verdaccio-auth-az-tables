{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Launch Verdaccio with Plugin",
      "program": "${workspaceFolder}/node_modules/.bin/verdaccio",
      "args": [
        "--config",
        "${workspaceFolder}/verdaccio-config.yaml"
      ],
      "cwd": "${workspaceFolder}",
      "runtimeArgs": [
        "--nolazy",
        "--inspect-brk"
      ],
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/lib/**/*.js"
      ],
      "env": {
        "DEBUG": "verdaccio*",
        "AZURE_LOG_LEVEL": "verbose"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "preLaunchTask": "Prepare Debug"
    }
  ]
}