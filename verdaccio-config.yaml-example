plugins: ./lib

listen:
  - 0.0.0.0:4873

auth:
  '@anddev-oss/verdaccio-auth-az-tables':
    azure:
      accountName: myazurestorageaccount
      usersTable: verdaccioUsers
      groupsTable: verdaccioGroups

packages:
  '**':
    access: $authenticated
    publish: $authenticated

storage: ./storage